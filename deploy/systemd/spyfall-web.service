[Unit]
Description=Spyfall Web
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=spyfall
Group=spyfall
WorkingDirectory=/opt/spyfall-web
EnvironmentFile=/etc/spyfall-web/spyfall-web.env
ExecStart=/opt/spyfall-web/.venv/bin/python /opt/spyfall-web/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/spyfall-web

[Install]
WantedBy=multi-user.target
